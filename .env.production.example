# Vercel web application; copy values into the provider's environment settings.
NEXT_PUBLIC_APP_URL=https://devkiller.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://ocfdbuslxrbliyvvwylf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
DATABASE_URL=YOUR_SUPABASE_POOLER_CONNECTION_STRING
DATABASE_POOL_SIZE=2
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
DEVKILLER_TRUSTED_ORIGINS=https://devkiller.vercel.app
# HTTPS host running the existing generator API + durable worker + Docker runners.
# Configure only on Vercel; leave unset on that upstream to avoid a proxy loop.
DK_GENERATOR_ORIGIN=https://YOUR_GENERATOR_HOST
# Keep NEXT_PUBLIC_DK_STATIC_PREVIEW unset on real deployments.
# Worker-only: OPENAI_API_KEY, DEVKILLER_WORKER_TOKEN and existing runtime config.

# Set on the generator host/worker for the requested launch model, after access validation.
DEVKILLER_ASTRA_EXPERIMENT=1
