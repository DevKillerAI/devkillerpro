# OpenAI (server only)
LLM_PROVIDER=OPENAI
OPENAI_API_KEY=replace-with-your-server-key
OPENAI_MODEL=gpt-5.6-terra
# Optional routing, disabled until compared with acceptance tests and token reports.
DEVKILLER_MODEL_ROUTING=disabled
# Stable cache routing for background mission calls. Disabling omits the hint; API automatic caching may still apply.
DEVKILLER_PROMPT_CACHE=enabled
# OPENAI_MODEL_COUNCIL=
# OPENAI_MODEL_BUILD=
# OPENAI_MODEL_QA=
# OPENAI_MODEL_REPAIR=

# Local PostgreSQL/Supabase. Replace with the hosted connection string later.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_SIZE=8

# Durable worker
DEVKILLER_BACKGROUND_JOBS=true
DEVKILLER_INTERNAL_URL=http://127.0.0.1:3000
DEVKILLER_WORKER_POLL_MS=2000
DEVKILLER_MAX_BUILD_ATTEMPTS=5
DEVKILLER_WORKER_TOKEN=replace-with-a-long-random-server-token
DEVKILLER_PILOT_EMAIL=owner@example.com
DEVKILLER_PILOT_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
DEVKILLER_PILOT_NAME=Pilot Owner

# Supabase public/server credentials are emitted by `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-from-local-status
SUPABASE_SERVICE_ROLE_KEY=replace-from-local-status
